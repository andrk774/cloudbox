# Скопируйте в .env и поправьте под себя: cp .env.example .env

# Внешний адрес (используется в публичных ссылках и для cookie Secure при https)
CB_PUBLIC_URL=http://localhost:8080
# Для профиля https (Caddy сам получит сертификат Let's Encrypt)
DOMAIN=cloud.example.ru

# Обязательно задайте случайную строку: openssl rand -hex 32
CB_SECRET=
DB_PASSWORD=cloudbox

# Открытая регистрация (первый пользователь регистрируется всегда и становится админом)
CB_ALLOW_REGISTRATION=false
# Квота по умолчанию для новых пользователей, МБ (0 — без ограничения)
CB_DEFAULT_QUOTA_MB=10240
# Максимальный размер одного файла, МБ
CB_MAX_UPLOAD_MB=4096
# Сколько предыдущих версий хранить на каждый файл
CB_MAX_VERSIONS=10
# Через сколько дней корзина очищается автоматически
CB_TRASH_DAYS=30

# Хранилище: local (диск в томе appdata) или s3
CB_STORAGE=local
# --- для CB_STORAGE=s3 (Garage, SeaweedFS, Yandex Object Storage, Selectel…)
CB_S3_ENDPOINT=http://garage:3900
CB_S3_REGION=garage
CB_S3_BUCKET=cloudbox
CB_S3_ACCESS_KEY=
CB_S3_SECRET_KEY=
CB_S3_PATH_STYLE=true
