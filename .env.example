# Скопируйте в .env и поправьте под себя: cp .env.example .env

# ---------- основное ----------
# Внешний адрес (используется в ссылках, cookie Secure при https, OIDC и WOPI)
CB_PUBLIC_URL=http://localhost:8080
# Для профиля https (Caddy сам получит сертификат Let's Encrypt)
DOMAIN=cloud.example.ru

# Обязательно задайте случайную строку: openssl rand -hex 32
CB_SECRET=
DB_PASSWORD=cloudbox
# Часовой пояс для дат съёмки фото без смещения и календаря
CB_TZ=Asia/Yekaterinburg

# Открытая регистрация (первый пользователь регистрируется всегда и становится админом)
CB_ALLOW_REGISTRATION=false
CB_DEFAULT_QUOTA_MB=10240
CB_MAX_UPLOAD_MB=16384
CB_MAX_VERSIONS=10
CB_TRASH_DAYS=30

# ---------- хранилище ----------
# local (диск в томе appdata) или s3
CB_STORAGE=local
CB_S3_ENDPOINT=http://garage:3900
CB_S3_REGION=garage
CB_S3_BUCKET=cloudbox
CB_S3_ACCESS_KEY=
CB_S3_SECRET_KEY=
CB_S3_PATH_STYLE=true

# Шифрование файлов на сервере (AES-256-GCM): openssl rand -hex 32
# ВНИМАНИЕ: потеря ключа = потеря всех файлов. Храните ключ отдельно от бэкапов.
CB_ENCRYPTION_KEY=

# ---------- резервное копирование ----------
# Ежедневный бэкап БД и файлов в ./backups (смонтирован в контейнер как /backups)
CB_BACKUP_DIR=/backups
CB_BACKUP_HOUR=3
CB_BACKUP_KEEP=7

# ---------- вход через OIDC (Authentik, Keycloak, Authelia, Zitadel) ----------
# Redirect URI у провайдера: ${CB_PUBLIC_URL}/api/auth/oidc/callback
CB_OIDC_ISSUER=
CB_OIDC_CLIENT_ID=
CB_OIDC_CLIENT_SECRET=
CB_OIDC_NAME=Войти через SSO
CB_OIDC_AUTO_CREATE=true
# true — привязать существующего пользователя по preferred_username. Опасно, если провайдер
# разрешает пользователям менять это имя: можно войти в чужую учётку (см. README)
CB_OIDC_LINK_BY_USERNAME=false
# false — вход только через OIDC (администраторы всё равно могут войти паролем);
# в WebDAV/CalDAV тогда работают только пароли приложений
CB_PASSWORD_LOGIN=true

# ---------- почта (см. README «Почта») ----------
# пароли ящиков шифруются ключом из CB_SECRET — без постоянного CB_SECRET почта отключена
#CB_MAIL_ALLOW_PRIVATE=false   # true — разрешить свой почтовый сервер в локальной сети
#CB_MAIL_EXTRA_PORTS=          # доп. порты через запятую, например 1143,1025 (Proton Mail Bridge)

# ---------- видеозвонки (профиль talk, см. README «Чат и видеозвонки») ----------
# без TURN звонки соединяются только внутри одной сети
#CB_TURN_SECRET=          # openssl rand -hex 32
#CB_TURN_URLS=turn:cloud.example.ru:3478?transport=udp,turn:cloud.example.ru:3478?transport=tcp
#CB_STUN_URLS=stun:cloud.example.ru:3478

# ---------- сеть ----------
# Откуда доверять X-Real-IP / X-Forwarded-For. По умолчанию — loopback и частные сети (прокси рядом).
# Сервер смотрит в интернет без прокси — укажите none
#CB_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# ---------- онлайн-офис (профиль office) ----------
OFFICE_DOMAIN=office.example.ru
COLLABORA_ADMIN_PASSWORD=change-me
# Как браузер видит Collabora
CB_WOPI_URL=
# Откуда CloudBox берёт discovery (внутри docker-сети)
CB_WOPI_DISCOVERY_URL=http://collabora:9980/hosting/discovery
# Как Collabora видит CloudBox (обычно публичный адрес)
CB_WOPI_HOST_URL=

# ---------- наблюдаемость ----------
CB_LOG_FORMAT=text
# Токен для /metrics (Prometheus). Без токена метрики доступны только из локальной/docker-сети.
CB_METRICS_TOKEN=
